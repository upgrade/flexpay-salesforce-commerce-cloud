{
  "root": true,
  "extends": "@jenssimon/sfcc/sfra",
  "rules": {
      "import/no-unresolved": "off",
      "indent": ["error", 4, { "SwitchCase": 1, "VariableDeclarator": 1 }],
      "func-names": "off",
      "require-jsdoc": "error",
      "valid-jsdoc": ["error", { "preferType": { "Boolean": "boolean", "Number": "number", "object": "Object", "String": "string" }, "requireReturn": false}],
      "vars-on-top": "off",
      "global-require": "off",
      "no-shadow": ["error", { "allow": ["err", "callback"]}],
      "max-len": "off",
      "no-trailing-spaces": "off",
      "no-else-return": "off",
      "operator-linebreak": "off",
      "function-paren-newline": "off",
      "no-multiple-empty-lines": "off",
      "no-plusplus": "off",
      "no-restricted-globals": "off"
    },
  "globals": {
    "dw": false,
    "customer": false,
    "session": false,
    "request": false,
    "response": false,
    "empty": false,
    "PIPELET_ERROR": false,
    "PIPELET_NEXT": false,
    "XML": false,
    "$": false,
    "jQuery": false,
    "describe": false,
    "it": false,
    "before": false,
    "beforeEach": false,
    "after": false,
    "afterEach": false
  }
}