<?xml version="1.0" encoding="UTF-8"?>
<metadata xmlns="http://www.demandware.com/xml/impex/metadata/2006-10-31">
 
    <type-extension type-id="SitePreferences">
        <custom-attribute-definitions>
            <attribute-definition attribute-id="flexPayEnabled">
                <display-name xml:lang="x-default">Enable Flex Pay</display-name>
                <type>boolean</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <default-value>true</default-value>
            </attribute-definition>
			<attribute-definition attribute-id="flexPayIntegrationType">
                <display-name xml:lang="x-default">Flex Pay Integration Type</display-name>
                <type>enum-of-string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <value-definitions>
                    <value-definition default="true">
                        <display xml:lang="x-default">VCN Integration</display>
                        <value>VCN</value>
                    </value-definition>
                    <value-definition>
                        <display xml:lang="x-default">Direct Settle Integration</display>
                        <value>DIRECT_SETTLE</value>
                    </value-definition>
                </value-definitions>
            </attribute-definition>

            <attribute-definition attribute-id="flexPaySdkKey">
                <display-name xml:lang="x-default">Flex Pay SDK Key</display-name>
                <type>password</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <min-length>0</min-length>
            </attribute-definition>

              <attribute-definition attribute-id="flexPayClientId">
                <display-name xml:lang="x-default">Flex Pay Client Id</display-name>
                <type>password</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <min-length>0</min-length>
            </attribute-definition>

              <attribute-definition attribute-id="flexPayClientSecret">
                <display-name xml:lang="x-default">Flex Pay Client Secret</display-name>
                <type>password</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <min-length>0</min-length>
            </attribute-definition>

            <attribute-definition attribute-id="flexPayMode">
                <display-name xml:lang="x-default">Flex Pay Mode</display-name>
                <type>enum-of-string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <value-definitions>
                    <value-definition default="true">
                        <display xml:lang="x-default">Sandbox</display>
                        <value>sandbox</value>
                    </value-definition>
                    <value-definition>
                        <display xml:lang="x-default">Production</display>
                        <value>production</value>
                    </value-definition>
                </value-definitions>
            </attribute-definition>

            <attribute-definition attribute-id="flexPayMarketingOfferEnabled">
                <display-name xml:lang="x-default">Enable FlexPay Marketing Offer Messages</display-name>
                <type>boolean</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <default-value>false</default-value>
            </attribute-definition>

            <attribute-definition attribute-id="flexPayMarketingOfferMinAmount">
                <display-name xml:lang="x-default">Minimum Amount for Marketing Offers</display-name>
                <type>double</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <default-value>50.0</default-value>
            </attribute-definition>

            <attribute-definition attribute-id="flexPayShowPdpMarketingOffer">
                <display-name xml:lang="x-default">Show PDP Marketing Offer</display-name>
                <description xml:lang="x-default">Enable or disable FlexPay marketing offer on Product Detail Pages</description>
                <type>boolean</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <default-value>true</default-value>
            </attribute-definition>
        </custom-attribute-definitions>

        <group-definitions>
            <attribute-group group-id="FlexPay">
                <display-name xml:lang="x-default">Flex Pay</display-name>
                <attribute attribute-id="flexPayEnabled"/>
                <attribute attribute-id="flexPayIntegrationType"/>
                <attribute attribute-id="flexPaySdkKey"/>
                <attribute attribute-id="flexPayClientId"/>
                <attribute attribute-id="flexPayClientSecret"/>
                <attribute attribute-id="flexPayMode"/>
                <attribute attribute-id="flexPayMarketingOfferEnabled"/>
                <attribute attribute-id="flexPayMarketingOfferMinAmount"/>
                <attribute attribute-id="flexPayShowPdpMarketingOffer"/>
            </attribute-group>
        </group-definitions>
    </type-extension>

    <type-extension type-id="Order">
        <custom-attribute-definitions>
            <attribute-definition attribute-id="isFlexPay">
                <display-name xml:lang="x-default">Is Flex Pay Payment</display-name>
                <type>boolean</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>

            <attribute-definition attribute-id="flexPayTransactionId">
                <display-name xml:lang="x-default">Flex Pay Transaction ID</display-name>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>

            <attribute-definition attribute-id="flexPayOrderID">
                <display-name xml:lang="x-default">Flex Pay Order ID</display-name>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>

            <attribute-definition attribute-id="flexPayTransactionStatus">
                <display-name xml:lang="x-default">Flex Pay Transaction Status</display-name>
                <description xml:lang="x-default">Flex Pay direct settle transaction status of a order</description>
                <type>enum-of-string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <value-definitions>
                    <value-definition>
                        <display xml:lang="x-default">AUTHORIZED</display>
                        <value>AUTHORIZED</value>
                    </value-definition>
                    <value-definition>
                        <display xml:lang="x-default">CAPTURED</display>
                        <value>CAPTURED</value>
                    </value-definition>
                    <value-definition>
                        <display xml:lang="x-default">VOIDED</display>
                        <value>VOIDED</value>
                    </value-definition>
                    <value-definition>
                        <display xml:lang="x-default">REFUNDED</display>
                        <value>REFUNDED</value>
                    </value-definition>
                </value-definitions>
            </attribute-definition>           
        </custom-attribute-definitions>

        <group-definitions>
            <attribute-group group-id="FlexPay">
                <display-name xml:lang="x-default">Flex Pay</display-name>
                <attribute attribute-id="isFlexPay"/>
                <attribute attribute-id="flexPayTransactionId"/>
                <attribute attribute-id="flexPayOrderID"/>
                <attribute attribute-id="flexPayTransactionStatus"/>
            </attribute-group>
        </group-definitions>
    </type-extension>   
</metadata>
