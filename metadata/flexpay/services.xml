    <service-profile service-profile-id="flexpay.profile">
        <timeout-millis>30000</timeout-millis>
        <rate-limit-enabled>false</rate-limit-enabled>
        <rate-limit-calls>0</rate-limit-calls>
        <rate-limit-millis>0</rate-limit-millis>
        <cb-enabled>true</cb-enabled>
        <cb-calls>10</cb-calls>
        <cb-millis>15000</cb-millis>
    </service-profile>


    <service service-id="FlexpayService">
        <service-type>HTTP</service-type>
        <enabled>true</enabled>
        <log-prefix>Flexpay</log-prefix>
        <comm-log-enabled>true</comm-log-enabled>
        <force-prd-enabled>false</force-prd-enabled>
        <mock-mode-enabled>false</mock-mode-enabled>
        <profile-id>flexpay.profile</profile-id>
        <!-- <credential-id>flexpay.credentials</credential-id> -->
    </service>

     <service service-id="FlexpayAuthService">
        <service-type>HTTP</service-type>
        <enabled>true</enabled>
        <log-prefix>Flexpay</log-prefix>
        <comm-log-enabled>true</comm-log-enabled>
        <force-prd-enabled>false</force-prd-enabled>
        <mock-mode-enabled>false</mock-mode-enabled>
        <profile-id>flexpay.profile</profile-id>
        <!-- <credential-id>flexpay.credentials</credential-id> -->
    </service>

</services>
