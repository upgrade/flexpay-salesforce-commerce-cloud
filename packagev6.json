{
  "name": "int_flexpay",
  "packageName": "int_flexpay_sfra",
  "version": "0.9.0",
  "description": "Flexpay's official cartridge for SFRA ",
  "main": "index.js",
  "author": "Upgrade",
  "scripts": {
    "lint": "sgmf-scripts --lint js && sgmf-scripts --lint css",
    "lint:fix": "sgmf-scripts --lint js --fix && sgmf-scripts --lint css --fix",
    "upload": "sgmf-scripts --upload -- ",
    "upload:v5": "sgmf-scripts --uploadCartridge int_flexpay && sgmf-scripts --uploadCartridge int_flexpay_sfra5",
    "upload:v6": "sgmf-scripts --uploadCartridge int_flexpay && sgmf-scripts --uploadCartridge int_flexpay_sfra",   
    "upload:v7": "sgmf-scripts --uploadCartridge int_flexpay && sgmf-scripts --uploadCartridge int_flexpay_sfra",   
    "compile:js": "sgmf-scripts --compile js",
    "compile:scss": "sgmf-scripts --compile css",
    "test": "sgmf-scripts --test test/unit/**/*.js",
    "cover": "sgmf-scripts --cover test/unit/**/*.js",
    "test:integration": "sgmf-scripts --integration 'test/integration/*.js'",
    "build": "npm run compile:js && npm run compile:scss",
    "build:v5": "cp packagev5.json package.json && npm run build",
    "build:v6": "cp packagev6.json package.json && npm run build",
    "build:v7": "cp packagev7.json package.json && npm run build",
    "watch": "sgmf-scripts --watch"
  },
  "dependencies": {
    "bootstrap": "^4.6.1",
    "cleave.js": "^1.5.3",
    "flag-icon-css": "^2.9.0",
    "font-awesome": "^4.7.0",
    "jquery": "^3.5.1",
    "parse-price": "^1.1.8"
  },
  "devDependencies": {
    "@babel/core": "^7.6.3",
    "@babel/plugin-proposal-object-rest-spread": "^7.6.2",
    "@babel/preset-env": "^7.6.3",
    "@jenssimon/eslint-config-base": "~1.3.0",
    "@jenssimon/eslint-config-sfcc": "~1.2.0",
    "babel-core": "^6.26.3",
    "babel-loader": "^8.0.6",
    "babel-preset-env": "^1.7.0",
    "chai": "^3.5.0",
    "chai-subset": "^1.6.0",
    "css-loader": "^1.0.1",
    "eslint": "^6.0.1",
    "eslint-config-airbnb-base": "^14.0.0",
    "eslint-plugin-import": "^2.16.0",
    "eslint-plugin-sitegenesis": "~1.0.0",
    "globalize": "^1.4.2",
    "husky": "^4.2.5",
    "isml-linter": "^5.26.4",
    "istanbul": "^0.4.5",
    "mocha": "^10.0.0",
    "mocha-junit-reporter": "^2.0.2",
    "moment-timezone": "^0.5.26",
    "postcss-loader": "^3.0.0",
    "properties-parser": "^0.3.1",
    "proxyquire": "1.7.4",
    "request-promise": "^4.2.4",
    "sass": "^1.51.0",
    "sass-loader": "^7.3.1",
    "selenium-standalone": "^6.16.0",
    "sgmf-scripts": "^2.4.2",
    "shelljs": "^0.8.5",
    "sinon": "^1.17.7",
    "stylelint": "^8.4.0",
    "stylelint-config-standard": "^17.0.0",
    "stylelint-scss": "^2.5.0",
    "url": "^0.11.0",
    "wdio-sauce-service": "^0.4.14",
    "webdriverio": "^5.14.5",
    "xml2js": "^0.5.0"
  },
  "browserslist": [
    "last 2 versions",
    "ie >= 10"
  ],
  "paths": {
    "base": "../storefront-reference-architecture-6.3.0/cartridges/app_storefront_base/"
  }
}
